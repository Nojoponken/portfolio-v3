# Environment ("development" or "production")
NODE_ENV=development

# Server port (defaults to 3500 if unset)
PORT=3500

# MongoDB connection string
# For local Docker dev: mongodb://localhost:27017/portfolio
# For production: your MongoDB Atlas or other hosted URI
DATABASE_URI=mongodb://localhost:27017/portfolio

# JWT signing secrets — use long random strings in production
ACCESS_TOKEN_SECRET=change_me_to_a_random_string
REFRESH_TOKEN_SECRET=change_me_to_another_random_string

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173
